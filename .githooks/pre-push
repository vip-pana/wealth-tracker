#!/bin/sh
#
# Pre-push gate: runs the same checks as CI, inside the Docker container
# (node_modules/vendor are the container's, so checks must run there).
# Enable with: composer setup-hooks  (or: git config core.hooksPath .githooks)
# Bypass once (not recommended): git push --no-verify

set -e

if ! docker compose ps --status running --services 2>/dev/null | grep -qx app; then
    echo "✗ The 'app' container isn't running. Start it with 'docker compose up -d' (or 'composer dev') and push again."
    exit 1
fi

run() {
    echo "→ $1"
    shift
    docker compose exec -T app sh -c "$*" || { echo "✗ $1 failed."; exit 1; }
}

run "Laravel Pint (style)"          "composer lint"
run "PHPStan (static analysis)"     "composer analyse"
run "Rector (refactoring check)"    "composer rector"
run "ESLint"                        "pnpm run lint"
run "TypeScript (tsc)"              "pnpm run typecheck"
run "Vitest (frontend tests)"       "pnpm run test"
run "PHPUnit (backend tests)"       "php artisan test"

echo "✓ All checks passed."
exit 0
