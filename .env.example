APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Enable Banking (open banking, read-only). Register a Production application at
# https://enablebanking.com, download its PEM private key, and link your own
# accounts (free "restricted mode"). APPLICATION_ID is the app uuid; the key
# path points to the downloaded .pem (keep it out of git). REDIRECT_URL is the
# HTTPS consent callback (e.g. a cloudflared/ngrok tunnel to /banking/callback);
# it must match the redirect registered on the Enable Banking app.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=
ENABLE_BANKING_REDIRECT_URL=

# Scalable Capital (read-only) via the official CLI (`sc`, headless in the
# container). Set SCALABLE_CLI_ENABLED=true to enable the sync, then log in from
# the app (Settings → "Collega") or with `docker exec -it wealth-tracker-app-1 sc
# login` (device code + 2FA). Each holding is matched to the asset carrying the
# same ISIN (set the asset's isin column). CASH_CATEGORY_ID + CASH_ASSET_NAME
# control where the uninvested cash is synced.
SCALABLE_CLI_ENABLED=false
SCALABLE_CASH_CATEGORY_ID=
SCALABLE_CASH_ASSET_NAME=

# AI advisor. ADVISOR_DRIVER selects the backend: 'ollama' (local, default),
# 'anthropic' (Claude cloud), or 'regolo' (EU cloud, zero-data-retention).
#
# ollama: local model on the host (the container reaches it via
# host.docker.internal); pull one first, e.g. `ollama pull qwen2.5:14b`. Inert
# until OLLAMA_MODEL is set.
ADVISOR_DRIVER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=120

# anthropic: Claude via the Anthropic API (ANTHROPIC_API_KEY read by Prism).
ADVISOR_ANTHROPIC_MODEL=
ADVISOR_ANTHROPIC_TIMEOUT=120

# regolo: Regolo (https://regolo.ai) via its OpenAI-compatible endpoint. Get an
# API key from the dashboard; pick a tool-capable model (e.g.
# Llama-3.3-70B-Instruct). Inert until REGOLO_MODEL is set.
REGOLO_BASE_URL=https://api.regolo.ai/v1
REGOLO_API_KEY=
REGOLO_MODEL=
REGOLO_TIMEOUT=120

VITE_APP_NAME="${APP_NAME}"
