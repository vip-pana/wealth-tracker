APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Self-hosting only (docker-compose.prod.yml). Auth key for the Tailscale
# sidecar that fronts the app with HTTPS — generate a reusable one under
# Settings → Keys on the Tailscale admin console. The prod stack refuses to
# start without it. Unused in development.
TS_AUTHKEY=
# Serving over plain http (no Tailscale sidecar, no TLS proxy) needs this set
# to false, or the session cookie is marked secure, never comes back, and every
# login fails with 419 Page Expired. Leave true when HTTPS is in front.
SESSION_SECURE_COOKIE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# 30 days: single-user app opened from a phone, where re-entering the password
# on every visit is friction without a matching security gain. Changing the
# password invalidates every existing session.
SESSION_LIFETIME=43200
# The session payload rides on a device that may leave the house.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Off-site backups. A backup that never leaves the machine dies with it, so set
# BACKUP_DISK to a configured filesystem disk ('s3' works with any
# S3-compatible provider) and every nightly backup is encrypted and uploaded
# there. Leave BACKUP_DISK empty to keep backups local-only.
#
# For Cloudflare R2, create a bucket + an API token, then reuse the s3 disk:
#   AWS_ACCESS_KEY_ID=<r2 access key id>
#   AWS_SECRET_ACCESS_KEY=<r2 secret access key>
#   AWS_BUCKET=<bucket name>
#   AWS_DEFAULT_REGION=auto
#   AWS_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#   AWS_USE_PATH_STYLE_ENDPOINT=true
#
# BACKUP_ENCRYPTION_KEY is required whenever BACKUP_DISK is set: the archive
# holds the full financial history and lands on third-party storage. Generate it
# with `php artisan backup:keygen` and keep a copy somewhere OTHER than the
# backup destination — without the key the archives cannot be restored.
# Restore with `php artisan backup:restore --list` then `backup:restore <key>`.
BACKUP_DISK=
BACKUP_DISK_PATH=wealth-tracker
BACKUP_ENCRYPTION_KEY=
# Warn (in-app notification) when the newest off-site backup is older than this.
BACKUP_MAX_AGE_DAYS=3

# Daily check (09:05) for commits the deployed build is missing, raised as an
# in-app notification. It never updates anything: an unattended pull would
# eventually deploy a change needing a new env key and leave the app down.
# Requires the image to be built with GIT_COMMIT (docker-compose.prod.yml does
# this), since .git is not in the build context. Leave the repository empty to
# disable. GITHUB_TOKEN is optional — the check uses one unauthenticated call a
# day, well inside GitHub's limit.
UPDATE_CHECK_REPOSITORY=vip-pana/wealth-tracker
UPDATE_CHECK_BRANCH=main
GITHUB_TOKEN=

# Enable Banking (open banking, read-only). Register a Production application at
# https://enablebanking.com, download its PEM private key, and link your own
# accounts (free "restricted mode"). APPLICATION_ID is the app uuid; the key
# path points to the downloaded .pem (keep it out of git). REDIRECT_URL is the
# HTTPS consent callback, and it must match the redirect registered on the
# Enable Banking app. With the Tailscale sidecar (see docker-compose.prod.yml)
# the app already has a real HTTPS name, so this is just
# https://<host>.<tailnet>.ts.net/banking/callback — registered once, no tunnel.
# Without one, it is a throwaway cloudflared/ngrok tunnel to /banking/callback.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=
ENABLE_BANKING_REDIRECT_URL=

# Account holder's surname as it appears in self-transfer notes (standing
# orders to self, Revolut "Payment from <name>" top-ups). Classifies those
# rows as internal transfers instead of income. Leave empty to disable.
SELF_TRANSFER_NAME=
# Extra transfer-note markers (account-specific, e.g. a card signature).
# Comma-separated; quote values that contain spaces. Leave empty to disable.
# Example: TRANSFER_MARKERS="Apple Pay Top-Up by *1234,Some Other Marker"
TRANSFER_MARKERS=

# Scalable Capital (read-only) via the official CLI (`sc`, headless in the
# container). Set SCALABLE_CLI_ENABLED=true to enable the sync, then log in from
# the app (Settings → "Collega") or with `docker exec -it wealth-tracker-app-1 sc
# login` (device code + 2FA). Each holding is matched to the asset carrying the
# same ISIN (set the asset's isin column). CASH_CATEGORY_ID + CASH_ASSET_NAME
# control where the uninvested cash is synced.
SCALABLE_CLI_ENABLED=false
SCALABLE_CASH_CATEGORY_ID=
SCALABLE_CASH_ASSET_NAME=

# AI advisor. ADVISOR_DRIVER selects the backend: 'ollama' (local, default),
# 'anthropic' (Claude cloud), or 'regolo' (EU cloud, zero-data-retention).
#
# ollama: local model on the host (the container reaches it via
# host.docker.internal); pull one first, e.g. `ollama pull qwen2.5:14b`. Inert
# until OLLAMA_MODEL is set.
ADVISOR_DRIVER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=120

# anthropic: Claude via the Anthropic API (ANTHROPIC_API_KEY read by Prism).
ANTHROPIC_API_KEY=
ADVISOR_ANTHROPIC_MODEL=
ADVISOR_ANTHROPIC_TIMEOUT=120

# regolo: Regolo (https://regolo.ai) via its OpenAI-compatible endpoint. Get an
# API key from the dashboard; pick a tool-capable model (e.g.
# Llama-3.3-70B-Instruct). Inert until REGOLO_MODEL is set.
REGOLO_BASE_URL=https://api.regolo.ai/v1
REGOLO_API_KEY=
REGOLO_MODEL=
REGOLO_TIMEOUT=120

VITE_APP_NAME="${APP_NAME}"
