APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Enable Banking (open banking, read-only). Register a Production application at
# https://enablebanking.com, download its PEM private key, and link your own
# accounts (free "restricted mode"). APPLICATION_ID is the app uuid; the key
# path points to the downloaded .pem (keep it out of git). REDIRECT_URL is the
# HTTPS consent callback (e.g. a cloudflared/ngrok tunnel to /banking/callback);
# it must match the redirect registered on the Enable Banking app.
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=
ENABLE_BANKING_REDIRECT_URL=

# Scalable Capital (stopgap, read-only). Reads positions from the local
# unofficial API proxy on the host. Run `./scripts/scalable-proxy-setup.sh` to
# install the proxy — it prints the GATEWAY_TOKEN to paste below (it lives in
# ~/scalable-unofficial/.token). Full setup: docs/scalable-proxy.md.
# BALANCE_URL enables the sync (host.docker.internal from the container). Each
# holding is matched to the asset carrying the same ISIN (set the asset's isin
# column). CASH_CATEGORY_ID + CASH_ASSET_NAME control where the uninvested cash
# is synced. Leave BALANCE_URL blank to disable.
SCALABLE_BALANCE_URL=
SCALABLE_GATEWAY_TOKEN=
SCALABLE_CASH_CATEGORY_ID=
SCALABLE_CASH_ASSET_NAME=

# Official Scalable CLI (`sc`, headless in the container). Set
# SCALABLE_CLI_ENABLED=true to use it; SCALABLE_SOURCE controls which source the
# sync reads: 'auto' (default) prefers a logged-in CLI and falls back to the
# proxy, 'cli' pins the CLI, 'proxy' pins the proxy. Log in once with
# `docker exec -it wealth-tracker-app-1 sc login` (device code + 2FA).
SCALABLE_SOURCE=auto
SCALABLE_CLI_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
